{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/**/*.{ts,mts,mjs}"],
			"project": ["scripts/**/*.{ts,mts,mjs}"]
		},
		"packages/codemod": {
			"entry": [
				"src/cli.ts",
				"src/swap/index.ts",
				"src/swap/browser.ts",
				"src/swap/adapters/panda/theme.ts",
				"tests/**/*.test.ts"
			],
			"project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
		},
		"packages/pandwind": {
			"entry": [
				"src/index.ts",
				"src/{css,cx,preset,stack,design,recipe,host,tw,vite}/index.ts",
				"src/{unplugin,source-scanner,rn,opentui}.ts",
				"src/css/create-stylesheet.ts",
				"src/css/stylesheet-lowering.ts",
				"src/css/runtime.ts",
				"src/tw/generate-types.ts",
				"tests/**/*.test.ts",
				"tests/**/*.tst.ts"
			],
			"project": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
		},
		"packages/analyze": {
			"entry": [
				"src/cli.ts",
				"src/collect/index.ts",
				"src/studio/index.ts",
				"studio-app/src/main.ts",
				"vite.config.ts",
				"tests/**/*.test.ts"
			],
			"project": ["src/**/*.ts", "tests/**/*.ts", "studio-app/**/*.{ts,html}", "vite.config.ts"]
		},
		"packages/lint-plugin": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"]
		},
		"apps/*": {
			"entry": ["src/{main,index,App}.{ts,tsx}", "vite.config.ts"],
			"project": ["src/**/*.{ts,tsx}", "vite.config.ts"]
		},
		"apps/playground": {
			"entry": ["src/{main,index,App}.{ts,tsx}", "vite.config.ts", "e2e/**/*.ts"],
			"project": ["src/**/*.{ts,tsx}", "vite.config.ts", "e2e/**/*.ts"]
		},
		"examples/*": {
			"entry": ["src/{main,index,App}.{ts,tsx}", "vite.config.ts", "test/**/*.{ts,tsx,mjs}"],
			"project": ["src/**/*.{ts,tsx}", "vite.config.ts", "test/**/*.{ts,tsx,mjs}"]
		},
		"examples/css-example": {
			"entry": [
				"src/{main,index,App}.{ts,tsx}",
				"src/hydration.tsx",
				"vite.config.ts",
				"test/**/*.{ts,tsx,mjs}"
			],
			"project": ["src/**/*.{ts,tsx}", "vite.config.ts", "test/**/*.{ts,tsx,mjs}"]
		},
		"docs": {
			"entry": ["astro.config.mjs", "src/content.config.ts"],
			"project": ["src/**/*.{ts,tsx,mjs,md,mdx}", "astro.config.mjs"]
		}
	},
	"ignoreDependencies": [
		"@astrojs/starlight",
		"@monaco-editor/react",
		"@opentui/core",
		"@tailwindcss/node",
		"@chakra-ui/react",
		"@pandacss/config",
		"@tokenami/config",
		"@unocss/config",
		"@unocss/core",
		"class-variance-authority",
		"pandwind",
		"pandwind-codemod",
		"pandwind-analyze",
		"postcss",
		"postcss-selector-parser",
		"react",
		"react-native",
		"react-native-web",
		"shiki",
		"tailwindcss",
		"oxc-parser",
		"@oxc-parser/binding-wasm32-wasi",
		"playwright-core"
	],
	"ignoreBinaries": ["rg"],
	"ignore": [
		"**/dist/**",
		"**/tests/fixtures/**",
		"**/tests/fixtures/**/*",
		"**/src/types.d.ts",
		"**/src/bridge.ts",
		"**/src/generated/**",
		"**/*.bench.{ts,mts}"
	]
}
