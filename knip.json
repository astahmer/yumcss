{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/**/*.{ts,mts,mjs}"],
			"project": ["scripts/**/*.{ts,mts,mjs}"]
		},
		"packages/codemod": {
			"entry": [
				"src/cli.ts",
				"src/css/index.ts",
				"src/lib/index.ts",
				"src/runtime/index.ts",
				"src/source-pass-utils.ts",
				"src/swap/index.ts",
				"src/swap/browser.ts",
				"src/swap/adapters/panda/theme.ts",
				"tests/**/*.test.ts"
			],
			"project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
			"ignoreDependencies": ["magic-string"]
		},
		"packages/pandwind": {
			"entry": [
				"src/index.ts",
				"src/{css,cx,preset,stack,design,recipe,host,tw,vite}/index.ts",
				"src/preset/csstype.ts",
				"src/preset/default.ts",
				"src/preset/tailwindcss.ts",
				"src/preset/chakra.ts",
				"src/preset/shadcn.ts",
				"src/{unplugin,source-scanner,rn,opentui}.ts",
				"src/css/create-stylesheet.ts",
				"src/css/stylesheet-lowering.ts",
				"src/css/runtime.ts",
				"src/css/runtime-codegen.ts",
				"src/tw/generate-types.ts",
				"tests/**/*.test.ts",
				"tests/**/*.tst.ts"
			],
			"project": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
		},
		"packages/analyze": {
			"entry": [
				"src/cli.ts",
				"src/collect/index.ts",
				"src/governance/index.ts",
				"src/mcp/http.ts",
				"src/mcp/server.ts",
				"src/studio/index.ts",
				"src/studio/server.ts",
				"studio-app/src/main.ts",
				"vite.config.ts",
				"tests/**/*.test.ts"
			],
			"project": ["src/**/*.ts", "tests/**/*.ts", "studio-app/**/*.{ts,html}", "vite.config.ts"]
		},
		"packages/lint-plugin": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"]
		},
		"apps/*": {
			"entry": ["src/{main,index,App}.{ts,tsx}", "vite.config.ts"],
			"project": ["src/**/*.{ts,tsx}", "vite.config.ts"]
		},
		"apps/playground": {
			"entry": [
				"src/{main,index,App}.{ts,tsx}",
				"src/lib/format-playground-code.ts",
				"vite.config.ts",
				"e2e/**/*.ts"
			],
			"project": ["src/**/*.{ts,tsx}", "vite.config.ts", "e2e/**/*.ts"]
		},
		"examples/*": {
			"entry": ["src/{main,index,App}.{ts,tsx}", "vite.config.ts", "test/**/*.{ts,tsx,mjs}"],
			"project": ["src/**/*.{ts,tsx}", "vite.config.ts", "test/**/*.{ts,tsx,mjs}"]
		},
		"examples/css-example": {
			"entry": [
				"src/{main,index,App}.{ts,tsx}",
				"src/hydration.tsx",
				"vite.config.ts",
				"test/**/*.{ts,tsx,mjs}"
			],
			"project": ["src/**/*.{ts,tsx}", "vite.config.ts", "test/**/*.{ts,tsx,mjs}"]
		},
		"examples/opentui-example": {
			"entry": ["src/index.tsx", "src/app.tsx", "test/**/*.{ts,tsx,mjs}"],
			"project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx,mjs}"]
		},
		"examples/showcase": {
			"entry": [
				"src/web/App.tsx",
				"src/native/App.tsx",
				"src/tui/main.tsx",
				"src/tui/app.tsx",
				"vite.config.ts",
				"test/**/*.{ts,tsx,mjs}"
			],
			"project": ["src/**/*.{ts,tsx}", "vite.config.ts", "test/**/*.{ts,tsx,mjs}"]
		},
		"examples/pandwind-example-preset": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"]
		},
		"benchmarks/styling-tsc": {
			"entry": ["runner/benchmark.mts"],
			"project": ["runner/**/*.mts"],
			"ignoreDependencies": [
				"@pandacss/dev",
				"@stylexjs/stylex",
				"@types/node",
				"@vanilla-extract/css",
				"@vanilla-extract/sprinkles",
				"csstype",
				"pandwind"
			]
		},
		"docs": {
			"entry": ["astro.config.mjs", "src/content.config.ts"],
			"project": ["src/**/*.{ts,tsx,mjs,md,mdx}", "astro.config.mjs"]
		}
	},
	"ignoreDependencies": [
		"@astrojs/starlight",
		"@monaco-editor/react",
		"@opentui/core",
		"@tailwindcss/node",
		"@chakra-ui/react",
		"@hono/node-server",
		"@pandwind/example-preset",
		"@pandacss/config",
		"@tokenami/config",
		"@unocss/config",
		"@unocss/core",
		"class-variance-authority",
		"pandwind",
		"pandwind-codemod",
		"pandwind-analyze",
		"postcss",
		"prettier",
		"react",
		"react-native",
		"react-native-web",
		"shiki",
		"tailwindcss",
		"oxc-parser",
		"@oxc-parser/binding-wasm32-wasi",
		"playwright-core"
	],
	"ignoreBinaries": ["rg"],
	"ignore": [
		"**/dist/**",
		"**/tests/fixtures/**",
		"**/tests/fixtures/**/*",
		"**/src/types.d.ts",
		"**/src/bridge.ts",
		"examples/example/src/tw.ts",
		"apps/playground/src/tw.ts",
		"examples/example/src/tw.build.ts",
		"apps/playground/src/tw.build.ts",
		"**/src/generated/**",
		"**/*.bench.{ts,mts}"
	]
}
