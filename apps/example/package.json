{
	"name": "example",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "pnpm tw:codegen && pnpm tw:bridge && pnpm tw:scan",
		"dev": "vite",
		"prebuild": "pnpm tw:codegen && pnpm tw:bridge && pnpm tw:scan",
		"build": "tsc -b && vite build",
		"typecheck": "tsc --noEmit",
		"tw:codegen": "tsx ../../packages/pandwind/src/tw/generate-types.ts ./src/tailwind.css ./src --tokens ../../packages/pandwind/src/preset/example-preset.ts",
		"tw:bridge": "tsx ../../packages/pandwind/src/tw/generate-bridge.ts ./src/tailwind.css ./src/tw.ts ./src/bridge.ts && oxfmt ./src/bridge.ts",
		"tw:scan": "tsx ../../packages/pandwind/src/tw/collect.ts ./src/tw.ts ./src ./src/pandwind.safelist.ts"
	},
	"dependencies": {
		"pandwind": "workspace:*",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react-swc": "4.3.3",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.12",
		"typescript": "7.0.2",
		"vite": "8.2.1"
	}
}
