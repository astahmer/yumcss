{
	"name": "playground",
	"private": true,
	"type": "module",
	"scripts": {
		"editor:types": "nub --node scripts/generate-editor-types.ts",
		"editor:types:check": "nub --node scripts/generate-editor-types.ts --check",
		"predev": "pnpm run panda:metadata && pnpm run editor:types && pnpm run tw:generate",
		"dev": "vite",
		"prebuild": "pnpm run panda:metadata && pnpm run editor:types && pnpm run tw:generate",
		"build": "tsc --noEmit && vite build",
		"typecheck": "pnpm run panda:metadata:check && pnpm run editor:types:check && tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"tw:generate": "pnpm exec yumcss-codemod tw generate ./src/tailwind.css ./src --tokens @yumcss/example-preset --preset-import @yumcss/example-preset --preset-export examplePreset --bridge && pnpm exec oxfmt ./src/types.d.ts ./src/tw.ts ./src/tw.runtime.ts ./src/tw.conflicts.ts ./src/tw.build.ts ./src/bridge.ts ./src/yumcss-theme.css && pnpm exec yumcss-codemod tw manifest ./src ./src/tailwind.css",
		"panda:metadata": "node scripts/generate-panda-metadata.mjs",
		"panda:metadata:check": "node scripts/generate-panda-metadata.mjs --check"
	},
	"dependencies": {
		"@ark-ui/react": "5.39.0",
		"@babel/standalone": "7.29.7",
		"@monaco-editor/react": "4.7.0",
		"@pandacss/core": "1.12.1",
		"@pandacss/generator": "1.12.1",
		"@pandacss/preset-base": "1.12.1",
		"@pandacss/preset-panda": "1.12.1",
		"@stylexjs/babel-plugin": "0.19.1",
		"@stylexjs/stylex": "0.19.1",
		"@tanstack/react-router": "1.170.32",
		"@unocss/core": "66.10.0",
		"@unocss/preset-wind3": "66.10.0",
		"@yumcss/codemod": "workspace:*",
		"@yumcss/example-preset": "workspace:*",
		"csstype": "3.2.3",
		"oxc-parser": "0.148.0",
		"path-browserify": "1.0.1",
		"prettier": "3.9.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"shiki": "4.4.3",
		"source-map-js": "1.2.1",
		"url": "0.11.4",
		"yumcss": "workspace:*"
	},
	"devDependencies": {
		"@oxc-parser/binding-wasm32-wasi": "0.148.0",
		"@pandacss/config": "1.12.1",
		"@playwright/test": "1.62.1",
		"@types/babel__standalone": "7.1.9",
		"@types/node": "26.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react-swc": "4.3.3",
		"playwright-bdd": "9.2.0",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "5.0.0"
	}
}
