{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"noEmit": true
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["src/generated/dependencies/modules.d.ts"]
}
