{
	"name": "pandwind-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r --if-present build",
		"dev": "pnpm --filter example dev",
		"typecheck": "pnpm -r --aggregate-output typecheck",
		"test": "pnpm --filter pandwind test && pnpm --filter pandwind test:types",
		"test:all": "pnpm -r --workspace-concurrency=1 --if-present test",
		"test:coverage": "pnpm --filter pandwind test:coverage && pnpm --filter pandwind-codemod test:coverage && pnpm --filter pandwind-analyze test:coverage",
		"codemod": "pnpm --filter pandwind-codemod exec tsx src/cli.ts",
		"inspect": "pnpm --filter inspector dev",
		"playground": "pnpm --filter playground dev",
		"tw:codegen": "pnpm --filter example tw:codegen",
		"analyze": "pnpm --filter pandwind-analyze exec tsx src/cli.ts --root \"$PWD\" --tw apps/example/src/tw.ts 'apps/example/src/**/*.ts' 'apps/example/src/**/*.tsx'",
		"lint": "oxlint --deny-warnings --report-unused-disable-directives",
		"lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"knip": "knip --reporter compact",
		"knip:production": "knip --production --reporter compact",
		"check": "oxlint --fix --deny-warnings --report-unused-disable-directives && oxfmt",
		"changeset": "changeset",
		"changeset:version": "changeset version && pnpm install --no-frozen-lockfile",
		"release:smoke": "for p in pandwind codemod analyze lint-plugin; do ./node_modules/.bin/tsx scripts/release/smoke-pack.mjs packages/$p || exit 1; done",
		"release:check": "tsx scripts/release/check-publish-ready.mjs",
		"release:publish": "bash scripts/release/publish-all.sh"
	},
	"devDependencies": {
		"@changesets/changelog-github": "0.5.1",
		"@changesets/cli": "2.29.7",
		"knip": "^6.32.3",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0",
		"tsx": "4.23.12",
		"typescript": "7.0.2"
	}
}
