{
	"name": "pandwind-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"package-manager:check": "node scripts/check-pnpm-version.mjs",
		"preinstall": "node scripts/check-pnpm-version.mjs",
		"build": "pnpm -r --if-present build",
		"dev": "pnpm --filter example run dev",
		"typecheck": "pnpm --workspace-concurrency=1 --filter pandwind-analyze --filter pandwind-codemod --filter pandwind --filter pandwind-devtools --filter @pandwind/lint-plugin --filter example --filter inspector --filter playground --filter css-example --filter opentui-example --filter rn-example --filter showcase --filter pandwind-docs run typecheck",
		"test": "pnpm --filter pandwind run test && pnpm --filter pandwind run test:types",
		"test:all": "pnpm -r --workspace-concurrency=1 --if-present test",
		"test:coverage": "pnpm --filter pandwind run test:coverage && pnpm --filter pandwind-codemod run test:coverage && pnpm --filter pandwind-analyze run test:coverage",
		"codemod": "pnpm --filter pandwind-codemod run cli",
		"inspect": "pnpm --filter inspector run dev",
		"playground": "pnpm --filter playground run dev",
		"tw:generate": "pnpm --filter example run tw:generate",
		"analyze": "pnpm --filter pandwind-analyze run cli --root \"$PWD\" --tw examples/example/src/tw.ts 'examples/example/src/**/*'",
		"mcp": "pnpm --filter pandwind-analyze run cli mcp",
		"migration-preview": "pnpm --filter pandwind-analyze run migration-preview",
		"compiler-preview": "pnpm --filter pandwind-analyze run compiler-preview",
		"lint": "pnpm --filter pandwind run build && pnpm --filter @pandwind/lint-plugin run build && pnpm exec oxlint --deny-warnings --report-unused-disable-directives",
		"lint:fix": "pnpm --filter pandwind run build && pnpm --filter @pandwind/lint-plugin run build && pnpm exec oxlint --fix --deny-warnings --report-unused-disable-directives",
		"format": "pnpm exec oxfmt --check",
		"format:fix": "pnpm exec oxfmt",
		"knip": "pnpm exec knip --reporter compact",
		"knip:production": "pnpm exec knip --production --reporter compact",
		"surface:check": "nub scripts/check-package-surface.ts",
		"generated:check": "nub scripts/check-generated-artifacts.ts",
		"generated:budget": "nub scripts/check-generated-artifact-budgets.ts",
		"generated:budget:report": "nub scripts/check-generated-artifact-budgets.ts --report",
		"presets:generate": "nub scripts/promote-tailwind-preset.ts && nub scripts/promote-chakra-preset.ts && nub scripts/promote-shadcn-preset.ts && nub scripts/promote-panda-preset.ts",
		"presets:check": "nub scripts/promote-tailwind-preset.ts --check && nub scripts/promote-chakra-preset.ts --check && nub scripts/promote-shadcn-preset.ts --check && nub scripts/promote-panda-preset.ts --check",
		"prose:generate": "nub scripts/promote-tailwind-prose.ts",
		"prose:check": "nub scripts/promote-tailwind-prose.ts --check",
		"references:prepare": "nub scripts/prepare-reference-repositories.ts",
		"references:deps": "nub scripts/prepare-reference-dependencies.ts",
		"references:check": "nub scripts/audit-real-repository-pins.ts",
		"migration:proof": "nub scripts/run-migration-proof.ts",
		"migration:proof:prepare": "nub scripts/run-migration-proof.ts prepare",
		"pivot:proof": "nub --conditions pandwind scripts/pivot-proof.ts",
		"pivot:proof:adapters": "nub --conditions pandwind scripts/run-adapter-reference-proof.ts",
		"pivot:proof:adapter-output": "nub --conditions pandwind scripts/verify-adapter-reference-output.ts",
		"pivot:proof:chakra": "nub --conditions pandwind scripts/verify-chakra-target-output.ts",
		"pivot:proof:references": "nub scripts/pivot-proof.ts --prepare",
		"pivot:proof:installed": "nub scripts/promote-goober-fixture.ts",
		"pivot:proof:installed:emotion": "nub scripts/promote-emotion-reference.ts",
		"pivot:proof:installed:stitches": "nub scripts/promote-stitches.ts",
		"pivot:proof:installed:mui": "nub scripts/promote-mui.ts",
		"pivot:proof:installed:mantine": "nub scripts/promote-mantine.ts",
		"pivot:proof:installed:tokenami": "nub scripts/promote-tokenami.ts",
		"pivot:proof:installed:vanilla-extract": "nub scripts/promote-vanilla-extract.ts",
		"pivot:proof:installed:jss": "nub --conditions pandwind scripts/promote-css-in-js.ts jss",
		"pivot:proof:installed:fela": "nub --conditions pandwind scripts/promote-css-in-js.ts fela",
		"pivot:proof:installed:aphrodite": "nub --conditions pandwind scripts/promote-css-in-js.ts aphrodite",
		"pivot:proof:installed:compiled": "nub --conditions pandwind scripts/promote-css-in-js.ts compiled",
		"pivot:proof:installed:style9": "nub --conditions pandwind scripts/promote-css-in-js.ts style9",
		"pivot:proof:installed:next-yak": "nub --conditions pandwind scripts/promote-css-in-js.ts next-yak",
		"pivot:proof:installed:linaria": "nub --conditions pandwind scripts/promote-framework-css-in-js.ts linaria",
		"pivot:proof:installed:solid-styled": "nub --conditions pandwind scripts/promote-framework-css-in-js.ts solid-styled",
		"pivot:proof:installed:vue-styled": "nub --conditions pandwind scripts/promote-framework-css-in-js.ts vue-styled",
		"pivot:proof:installed:treat": "nub --conditions pandwind scripts/promote-treat.ts",
		"pivot:proof:installed:panda": "nub --conditions pandwind scripts/promote-panda-fixture.ts",
		"pivot:proof:installed:panda:website": "nub --conditions pandwind scripts/promote-panda-website.ts",
		"pivot:proof:installed:unocss": "nub --conditions pandwind scripts/promote-unocss-fixture.ts",
		"pivot:proof:installed:unocss:next": "nub --conditions pandwind scripts/promote-unocss-next.ts",
		"pivot:proof:installed:styled-components": "nub --conditions pandwind scripts/promote-styled-components-fixture.ts",
		"pivot:proof:installed:tailwind": "nub --conditions pandwind scripts/promote-tailwind-fixture.ts",
		"pivot:proof:installed:routes": "nub --conditions pandwind scripts/verify-installed-route-proofs.ts",
		"pivot:proof:installed:routes:run": "nub --conditions pandwind scripts/verify-installed-route-proofs.ts --run",
		"proof:docs:check": "nub scripts/check-proof-documentation.ts",
		"pivot:migrate:reference": "nub scripts/run-migration-proof.ts run reference-repository",
		"bench:tooling": "nub scripts/benchmark-tooling.mts",
		"bench:tsc": "nub scripts/benchmark-tsc.mts",
		"bench:tsc:example": "nub scripts/benchmark-tsc.mts --target example",
		"bench:tsc:styling": "nub benchmarks/styling-tsc/runner/benchmark.mts",
		"bench:tsc:generated": "nub benchmarks/styling-tsc/runner/generated-types-poc.mts",
		"bench:size:ecosystem": "nub benchmarks/styling-size/runner/benchmark.mts",
		"bench:summary": "nub scripts/render-performance-summary.mts",
		"bench:summary:check": "nub scripts/render-performance-summary.mts --check",
		"bench:migration-preview": "nub scripts/benchmark-migration-preview.mts",
		"migration-preview:proof:host": "nub scripts/run-migration-preview-host-proof.mts",
		"check": "pnpm --filter pandwind run build && pnpm --filter @pandwind/lint-plugin run build && pnpm exec oxlint --fix --deny-warnings --report-unused-disable-directives && pnpm exec oxfmt && pnpm run surface:check && pnpm run generated:check && pnpm run generated:budget && pnpm run presets:check && pnpm run prose:check && pnpm run bench:summary:check && pnpm run proof:docs:check",
		"changeset": "pnpm exec changeset",
		"changeset:version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
		"release:smoke": "for p in pandwind codemod analyze devtools lint-plugin; do node scripts/release/smoke-pack.mjs packages/$p || exit 1; done",
		"test:e2e:playground": "pnpm exec bddgen test && pnpm exec playwright test",
		"test:e2e:migration-preview": "pnpm exec bddgen -c playwright.migration-preview.config.ts test && pnpm exec playwright test -c playwright.migration-preview.config.ts",
		"test:e2e:authored-tokens": "nub scripts/verify-authored-token-browser.ts",
		"release:check": "node scripts/release/check-publish-ready.mjs",
		"release:publish": "bash scripts/release/publish-all.sh"
	},
	"devDependencies": {
		"@chakra-ui/react": "3.37.0",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.2",
		"@effect/platform-node": "4.0.0-beta.107",
		"@pandacss/config": "1.12.1",
		"@pandwind/example-preset": "workspace:*",
		"@playwright/test": "1.62.1",
		"@tokenami/config": "0.0.101",
		"@unocss/config": "66.10.0",
		"@unocss/core": "66.10.0",
		"cac": "7.0.0",
		"effect": "4.0.0-beta.107",
		"knip": "6.34.0",
		"less": "4.9.1",
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"pandwind": "workspace:*",
		"pandwind-codemod": "workspace:*",
		"pixelmatch": "7.2.0",
		"playwright-bdd": "9.2.0",
		"playwright-core": "1.62.1",
		"pngjs": "7.0.0",
		"sass": "1.104.0",
		"shadcn": "4.19.0",
		"typescript": "7.0.2",
		"zod": "3.25.76"
	},
	"packageManager": "pnpm@12.3.4"
}
