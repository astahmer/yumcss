{
	"name": "pandwind-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nub run -r --if-present build",
		"dev": "nub run --filter example dev",
		"typecheck": "nub run --filter pandwind-analyze --filter pandwind-codemod --filter pandwind --filter @pandwind/lint-plugin --filter example --filter inspector --filter playground --filter css-example --filter opentui-example --filter rn-example --filter showcase --filter pandwind-docs --workspace-concurrency=1 typecheck",
		"test": "nub run --filter pandwind test && nub run --filter pandwind test:types",
		"test:all": "nub run -r --workspace-concurrency=1 --if-present test",
		"test:coverage": "nub run --filter pandwind test:coverage && nub run --filter pandwind-codemod test:coverage && nub run --filter pandwind-analyze test:coverage",
		"codemod": "nub run --filter pandwind-codemod cli",
		"inspect": "nub run --filter inspector dev",
		"playground": "nub run --filter playground dev",
		"tw:generate": "nub run --filter example tw:generate",
		"analyze": "nub run --filter pandwind-analyze cli --root \"$PWD\" --tw apps/example/src/tw.ts 'apps/example/src/**/*.ts' 'apps/example/src/**/*.tsx'",
		"mcp": "nub run --filter pandwind-analyze cli mcp",
		"studio": "nub run --filter pandwind-analyze studio",
		"lint": "nub run --filter @pandwind/lint-plugin build && oxlint --deny-warnings --report-unused-disable-directives",
		"lint:fix": "nub run --filter @pandwind/lint-plugin build && oxlint --fix --deny-warnings --report-unused-disable-directives",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"knip": "knip --reporter compact",
		"knip:production": "knip --production --reporter compact",
		"references:prepare": "nub scripts/prepare-reference-repositories.ts",
		"references:deps": "nub scripts/prepare-reference-dependencies.ts",
		"references:check": "nub scripts/audit-real-repository-pins.ts",
		"pivot:proof": "nub --conditions pandwind scripts/pivot-proof.ts",
		"pivot:proof:adapters": "nub --conditions pandwind scripts/run-adapter-reference-proof.ts",
		"pivot:proof:adapter-output": "nub --conditions pandwind scripts/verify-adapter-reference-output.ts",
		"pivot:proof:chakra": "nub --conditions pandwind scripts/verify-chakra-target-output.ts",
		"pivot:proof:references": "nub scripts/pivot-proof.ts --prepare",
		"pivot:proof:installed": "nub scripts/promote-goober-fixture.ts",
		"pivot:proof:installed:emotion": "nub scripts/promote-emotion-reference.ts",
		"pivot:migrate:reference": "nub scripts/migrate-reference-repository.ts",
		"bench:tooling": "nub scripts/benchmark-tooling.mts",
		"bench:studio": "nub scripts/benchmark-studio.mts",
		"check": "nub run --filter @pandwind/lint-plugin build && oxlint --fix --deny-warnings --report-unused-disable-directives && oxfmt",
		"changeset": "changeset",
		"changeset:version": "changeset version && nub install --no-frozen-lockfile",
		"release:smoke": "for p in pandwind codemod analyze lint-plugin; do nub scripts/release/smoke-pack.mjs packages/$p || exit 1; done",
		"test:e2e:playground": "bddgen test && playwright test",
		"test:e2e:studio": "bddgen -c playwright.studio.config.ts test && playwright test -c playwright.studio.config.ts",
		"release:check": "nub scripts/release/check-publish-ready.mjs",
		"release:publish": "bash scripts/release/publish-all.sh"
	},
	"devDependencies": {
		"@chakra-ui/react": "3.37.0",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.2",
		"@effect/platform-node": "4.0.0-beta.107",
		"@pandacss/config": "1.12.1",
		"@playwright/test": "1.62.1",
		"@tokenami/config": "0.0.101",
		"@unocss/config": "66.10.0",
		"@unocss/core": "66.10.0",
		"effect": "4.0.0-beta.107",
		"knip": "6.34.0",
		"less": "4.9.1",
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"pandwind": "workspace:*",
		"pandwind-codemod": "workspace:*",
		"pixelmatch": "7.2.0",
		"playwright-bdd": "9.2.0",
		"playwright-core": "1.62.1",
		"pngjs": "7.0.0",
		"sass": "1.104.0",
		"typescript": "7.0.2"
	}
}
