		"csstype": "3.2.3",
		"flattie": "1.1.1",
		"oxc-parser": "0.144.0",
		"postcss-selector-parser": "7.1.5",
		"tailwindcss": "4.3.3",
		"unplugin": "3.3.0"
	},
	"devDependencies": {
		"@types/node": "26.2.0",
		"@types/react": "19.2.8",
		"@types/react-dom": "19.2.4",
		"esbuild": "0.28.2",
		"postcss": "8.5.26",
		"react-dom": "19.2.8",
		"rollup": "4.62.5",
		"tailwind-merge": "3.6.0",
		"tstyche": "7.2.2",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vitest": "4.1.10",
		"webpack": "5.101.3"
	},
