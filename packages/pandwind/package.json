{
	"name": "pandwind",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./css": "./src/css/index.ts",
		"./css/runtime": "./src/css/runtime.ts",
		"./cx": "./src/cx/index.ts",
		"./preset": "./src/preset/index.ts",
		"./stack": "./src/stack/index.ts",
		"./stack/react": "./src/stack/react.tsx",
		"./design": "./src/design/index.ts",
		"./recipe": "./src/recipe/index.ts",
		"./host": "./src/host/index.ts",
		"./tw": "./src/tw/index.ts",
		"./tw/generate": "./src/tw/generate-types.ts",
		"./tw/collect": "./src/tw/collect.ts",
		"./vite": "./src/vite/index.ts",
		"./unplugin": "./src/unplugin.ts",
		"./codegen/types": "./src/tw/generate-types.ts",
		"./codegen/theme": "./src/tw/generate-theme.ts",
		"./codegen/collect": "./src/tw/collect.ts",
		"./react-native": "./src/rn.ts",
		"./opentui": "./src/opentui.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
