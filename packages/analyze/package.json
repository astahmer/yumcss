{
	"name": "pandwind-analyze",
	"version": "0.1.0",
	"keywords": [
		"analysis",
		"coverage",
		"css",
		"size-budget",
		"tailwind"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astahmer/pandwind.git",
		"directory": "packages/analyze"
	},
	"bin": {
		"pandwind-analyze": "./dist/cli.js",
		"pandwind-compiler-preview": "./dist/compiler-preview/cli.js",
		"pandwind-migration-preview": "./dist/migration-preview/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		".": {
			"pandwind": "./src/cli.ts",
			"types": "./dist/cli.d.ts",
			"import": "./dist/cli.js",
			"default": "./dist/cli.js"
		},
		"./collect": {
			"pandwind": "./src/collect/index.ts",
			"types": "./dist/collect/index.d.ts",
			"import": "./dist/collect/index.js",
			"default": "./dist/collect/index.js"
		},
		"./collect/browser": {
			"pandwind": "./src/collect/browser.ts",
			"types": "./dist/collect/browser.d.ts",
			"import": "./dist/collect/browser.js",
			"default": "./dist/collect/browser.js"
		},
		"./governance": {
			"pandwind": "./src/governance/index.ts",
			"types": "./dist/governance/index.d.ts",
			"import": "./dist/governance/index.js",
			"default": "./dist/governance/index.js"
		},
		"./governance/browser": {
			"pandwind": "./src/governance/browser.ts",
			"types": "./dist/governance/browser.d.ts",
			"import": "./dist/governance/browser.js",
			"default": "./dist/governance/browser.js"
		},
		"./migration-preview": {
			"pandwind": "./src/migration-preview/index.ts",
			"types": "./dist/migration-preview/index.d.ts",
			"import": "./dist/migration-preview/index.js",
			"default": "./dist/migration-preview/index.js"
		},
		"./mcp": {
			"pandwind": "./src/mcp/server.ts",
			"types": "./dist/mcp/server.d.ts",
			"import": "./dist/mcp/server.js",
			"default": "./dist/mcp/server.js"
		},
		"./mcp/http": {
			"pandwind": "./src/mcp/http.ts",
			"types": "./dist/mcp/http.d.ts",
			"import": "./dist/mcp/http.js",
			"default": "./dist/mcp/http.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build:ui": "pnpm exec vite build",
		"build:compiler-preview-ui": "pnpm exec vite build --config vite.compiler-preview.config.ts",
		"build": "pnpm exec tsdown && pnpm run build:ui && pnpm run build:compiler-preview-ui",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"cli": "node dist/cli.js",
		"migration-preview": "node dist/migration-preview/cli.js",
		"compiler-preview": "node dist/compiler-preview/cli.js",
		"corpus": "pnpm run cli \"tests/fixtures/coverage-corpus/*.ts\" --tw ../../examples/example/src/tw.ts --root ."
	},
	"dependencies": {
		"@hono/node-server": "2.1.1",
		"@modelcontextprotocol/server": "2.0.0",
		"@tailwindcss/node": "4.3.3",
		"cac": "7.0.0",
		"hono": "4.13.5",
		"pandwind": "workspace:*",
		"pandwind-codemod": "workspace:*",
		"postcss": "8.5.28",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@pandwind/example-preset": "workspace:*",
		"@pierre/diffs": "1.4.3",
		"@types/node": "26.4.1",
		"@vitest/coverage-v8": "5.0.0",
		"oxc-parser": "0.148.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vite-plugin-singlefile": "2.3.3",
		"vitest": "5.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}
