{
	"name": "pandwind-analyze",
	"version": "0.1.0",
	"keywords": [
		"analysis",
		"coverage",
		"css",
		"size-budget",
		"tailwind"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astahmer/pandwind.git",
		"directory": "packages/pandwind-analyze"
	},
	"bin": {
		"pandwind-analyze": "./src/cli.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		".": "./src/cli.ts",
		"./collect": "./src/collect/index.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"corpus": "tsx src/cli.ts \"analyze/tests/fixtures/coverage-corpus/*.ts\" --tw ../apps/example/src/tw.ts --root .."
	},
	"dependencies": {
		"@tailwindcss/node": "4.3.3",
		"pandwind": "workspace:*",
		"postcss": "8.5.26"
	},
	"devDependencies": {
		"@types/node": "26.2.0",
		"oxc-parser": "0.144.0",
		"tsx": "4.23.12",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=20"
	}
}
