{
	"name": "pandwind-analyze",
	"version": "0.1.0",
	"keywords": [
		"analysis",
		"coverage",
		"css",
		"size-budget",
		"tailwind"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astahmer/pandwind.git",
		"directory": "packages/pandwind-analyze"
	},
	"bin": {
		"pandwind-analyze": "./dist/cli.js",
		"pandwind-studio": "./dist/studio/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		".": {
			"pandwind": "./src/cli.ts",
			"types": "./dist/cli.d.ts",
			"import": "./dist/cli.js",
			"default": "./dist/cli.js"
		},
		"./collect": {
			"pandwind": "./src/collect/index.ts",
			"types": "./dist/collect/index.d.ts",
			"import": "./dist/collect/index.js",
			"default": "./dist/collect/index.js"
		},
		"./governance": {
			"pandwind": "./src/governance/index.ts",
			"types": "./dist/governance/index.d.ts",
			"import": "./dist/governance/index.js",
			"default": "./dist/governance/index.js"
		},
		"./studio": {
			"pandwind": "./src/studio/index.ts",
			"types": "./dist/studio/index.d.ts",
			"import": "./dist/studio/index.js",
			"default": "./dist/studio/index.js"
		},
		"./mcp": {
			"pandwind": "./src/mcp/server.ts",
			"types": "./dist/mcp/server.d.ts",
			"import": "./dist/mcp/server.js",
			"default": "./dist/mcp/server.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build:ui": "nub exec vite build",
		"build": "nub exec tsdown && nub run build:ui",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"cli": "node dist/cli.js",
		"studio": "node dist/studio/cli.js",
		"corpus": "nub run cli \"analyze/tests/fixtures/coverage-corpus/*.ts\" --tw ../apps/example/src/tw.ts --root .."
	},
	"dependencies": {
		"@hono/node-server": "2.1.1",
		"@modelcontextprotocol/server": "2.0.0",
		"@tailwindcss/node": "4.3.3",
		"cac": "7.0.0",
		"hono": "4.13.5",
		"pandwind": "workspace:*",
		"pandwind-codemod": "workspace:*",
		"postcss": "8.5.28",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@types/node": "26.4.1",
		"@vitest/coverage-v8": "5.0.0",
		"oxc-parser": "0.148.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vite-plugin-singlefile": "2.3.3",
		"vitest": "5.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}
