{
	"name": "@yumcss/devtools",
	"version": "0.1.0",
	"description": "Vite DevTools for inspecting YumCSS style programs and migrations",
	"keywords": [
		"css",
		"devtools",
		"migration",
		"vite",
		"yumcss"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astahmer/yumcss.git",
		"directory": "packages/devtools"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		".": {
			"yumcss": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./inspect-action": {
			"yumcss": "./src/client/inspect-action.ts",
			"types": "./dist/client/inspect-action.d.ts",
			"import": "./dist/client/inspect-action.js",
			"default": "./dist/client/inspect-action.js"
		},
		"./evidence": {
			"yumcss": "./src/evidence/index.ts",
			"types": "./dist/evidence/index.d.ts",
			"import": "./dist/evidence/index.js",
			"default": "./dist/evidence/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "pnpm exec tsdown && pnpm exec vite build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts"
	},
	"dependencies": {
		"@vitejs/devtools-kit": "0.7.2",
		"@yumcss/codemod": "workspace:*",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"yumcss": "workspace:*"
	},
	"devDependencies": {
		"@fontsource-variable/bricolage-grotesque": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@types/node": "26.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/devtools": "0.7.2",
		"@vitejs/plugin-react-swc": "4.3.3",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "5.0.0"
	},
	"peerDependencies": {
		"@vitejs/devtools": "0.7.2",
		"vite": ">=8.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}
