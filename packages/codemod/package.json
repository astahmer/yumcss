{
	"name": "@yumcss/codemod",
	"version": "0.1.0",
	"keywords": [
		"codemod",
		"css",
		"migration",
		"panda-css",
		"stylex",
		"tailwind"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astahmer/yumcss.git",
		"directory": "packages/codemod"
	},
	"bin": {
		"yumcss-codemod": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		".": {
			"yumcss": "./src/cli.ts",
			"types": "./dist/cli.d.ts",
			"import": "./dist/cli.js",
			"default": "./dist/cli.js"
		},
		"./diff": {
			"yumcss": "./src/diff.ts",
			"types": "./dist/diff.d.ts",
			"import": "./dist/diff.js",
			"default": "./dist/diff.js"
		},
		"./swap": {
			"yumcss": "./src/swap/index.ts",
			"types": "./dist/swap/index.d.ts",
			"import": "./dist/swap/index.js",
			"default": "./dist/swap/index.js"
		},
		"./swap/semantic-ir": {
			"yumcss": "./src/swap/semantic-ir.ts",
			"types": "./dist/swap/semantic-ir.d.ts",
			"import": "./dist/swap/semantic-ir.js",
			"default": "./dist/swap/semantic-ir.js"
		},
		"./swap/official-api-cases": {
			"yumcss": "./src/swap/official-api-cases.ts",
			"types": "./dist/swap/official-api-cases.d.ts",
			"import": "./dist/swap/official-api-cases.js",
			"default": "./dist/swap/official-api-cases.js"
		},
		"./swap/identifiers": {
			"yumcss": "./src/swap/identifiers.ts",
			"types": "./dist/swap/identifiers.d.ts",
			"import": "./dist/swap/identifiers.js",
			"default": "./dist/swap/identifiers.js"
		},
		"./swap/official/panda": {
			"yumcss": "./src/swap/adapters/panda/theme.ts",
			"types": "./dist/swap/adapters/panda/theme.d.ts",
			"import": "./dist/swap/adapters/panda/theme.js",
			"default": "./dist/swap/adapters/panda/theme.js"
		},
		"./swap/corpus": {
			"yumcss": "./src/swap/real-repository-corpus.ts",
			"types": "./dist/swap/real-repository-corpus.d.ts",
			"import": "./dist/swap/real-repository-corpus.js",
			"default": "./dist/swap/real-repository-corpus.js"
		},
		"./migration/meta": {
			"yumcss": "./src/meta.ts",
			"types": "./dist/meta.d.ts",
			"import": "./dist/meta.js",
			"default": "./dist/meta.js"
		},
		"./migration/map": {
			"yumcss": "./src/map.ts",
			"types": "./dist/map.d.ts",
			"import": "./dist/map.js",
			"default": "./dist/map.js"
		},
		"./migration/shared": {
			"yumcss": "./src/shared.ts",
			"types": "./dist/shared.d.ts",
			"import": "./dist/shared.js",
			"default": "./dist/shared.js"
		},
		"./migration/tokens": {
			"yumcss": "./src/tokens.ts",
			"types": "./dist/tokens.d.ts",
			"import": "./dist/tokens.js",
			"default": "./dist/tokens.js"
		},
		"./migration/class-sorter": {
			"yumcss": "./src/class-sorter.ts",
			"types": "./dist/class-sorter.d.ts",
			"import": "./dist/class-sorter.js",
			"default": "./dist/class-sorter.js"
		},
		"./migration/arbitrary-values": {
			"yumcss": "./src/arbitrary-values.ts",
			"types": "./dist/arbitrary-values.d.ts",
			"import": "./dist/arbitrary-values.js",
			"default": "./dist/arbitrary-values.js"
		},
		"./swap/variant-hoisting": {
			"yumcss": "./src/swap/variant-hoisting.ts",
			"types": "./dist/swap/variant-hoisting.d.ts",
			"import": "./dist/swap/variant-hoisting.js",
			"default": "./dist/swap/variant-hoisting.js"
		},
		"./swap/token-document": {
			"yumcss": "./src/swap/token-document-codec.ts",
			"types": "./dist/swap/token-document-codec.d.ts",
			"import": "./dist/swap/token-document-codec.js",
			"default": "./dist/swap/token-document-codec.js"
		},
		"./swap/token-document/serializer": {
			"yumcss": "./src/swap/token-document-serializer.ts",
			"types": "./dist/swap/token-document-serializer.d.ts",
			"import": "./dist/swap/token-document-serializer.js",
			"default": "./dist/swap/token-document-serializer.js"
		},
		"./swap/unplugin": {
			"yumcss": "./src/swap/unplugin.ts",
			"types": "./dist/swap/unplugin.d.ts",
			"import": "./dist/swap/unplugin.js",
			"default": "./dist/swap/unplugin.js"
		},
		"./swap/vite": {
			"yumcss": "./src/swap/vite.ts",
			"types": "./dist/swap/vite.d.ts",
			"import": "./dist/swap/vite.js",
			"default": "./dist/swap/vite.js"
		},
		"./swap/browser": {
			"yumcss": "./src/swap/browser.ts",
			"types": "./dist/swap/browser.d.ts",
			"import": "./dist/swap/browser.js",
			"default": "./dist/swap/browser.js"
		},
		"./tw": {
			"yumcss": "./src/tw/index.ts",
			"types": "./dist/tw/index.d.ts",
			"import": "./dist/tw/index.js",
			"default": "./dist/tw/index.js"
		},
		"./runtime": {
			"yumcss": "./src/runtime/index.ts",
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime/index.js",
			"default": "./dist/runtime/index.js"
		},
		"./lib": {
			"yumcss": "./src/lib/index.ts",
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js",
			"default": "./dist/lib/index.js"
		},
		"./css": {
			"yumcss": "./src/css/index.ts",
			"types": "./dist/css/index.d.ts",
			"import": "./dist/css/index.js",
			"default": "./dist/css/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "pnpm exec tsdown",
		"cli": "node dist/cli.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:routes": "vitest run tests/routes",
		"test:roundtrips": "vitest run tests/roundtrips",
		"test:route-matrix": "vitest --config vitest.route-matrix.config.ts run",
		"refresh:canonicality-ledger": "pnpm run build && nub scripts/refresh-canonicality-ledger.ts",
		"generate:route-tests": "nub ../../scripts/generate-adapter-route-specs.ts",
		"generate:roundtrip-tests": "nub ../../scripts/generate-adapter-route-specs.ts",
		"test:coverage": "vitest run --coverage && nub scripts/check-adapter-coverage.ts",
		"test:e2e": "vitest run tests/adapter-cli-e2e.test.ts tests/adapter-cli-full-matrix.test.ts"
	},
	"dependencies": {
		"@emotion/unitless": "0.10.0",
		"@tailwindcss/node": "4.3.3",
		"cac": "7.0.0",
		"esbuild": "0.28.2",
		"magic-string": "1.2.3",
		"oxc-parser": "0.148.0",
		"yumcss": "workspace:*",
		"postcss": "8.5.28",
		"tailwind-merge": "3.6.0",
		"unplugin": "3.3.0",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@chakra-ui/react": "3.37.0",
		"@mantine/core": "9.6.0",
		"@yumcss/example-preset": "workspace:*",
		"@types/node": "26.4.1",
		"@vitest/coverage-v8": "5.0.0",
		"jss": "10.10.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vitest": "5.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}
