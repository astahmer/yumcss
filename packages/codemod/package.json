{
	"name": "pandwind-codemod",
	"version": "0.1.0",
	"keywords": [
		"codemod",
		"css",
		"migration",
		"panda-css",
		"stylex",
		"tailwind"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astahmer/pandwind.git",
		"directory": "packages/pandwind-codemod"
	},
	"bin": {
		"pandwind-codemod": "./src/cli.ts"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		".": "./src/cli.ts",
		"./swap": "./src/swap/index.ts",
		"./swap/browser": "./src/swap/browser.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:routes": "vitest run tests/routes",
		"test:roundtrips": "vitest run tests/roundtrips",
		"test:route-matrix": "vitest --config vitest.route-matrix.config.ts run",
		"generate:route-tests": "tsx ../../scripts/generate-adapter-route-specs.ts",
		"generate:roundtrip-tests": "tsx ../../scripts/generate-adapter-route-specs.ts",
		"test:coverage": "vitest run --coverage && tsx scripts/check-adapter-coverage.ts",
		"test:e2e": "PANDWIND_CLI_MATRIX_E2E=1 vitest run tests/adapter-cli-e2e.test.ts tests/adapter-cli-full-matrix.test.ts"
	},
	"dependencies": {
		"@tailwindcss/node": "4.3.3",
		"pandwind": "workspace:*"
	},
	"devDependencies": {
		"@mantine/core": "^9.5.2",
		"@types/node": "26.2.0",
		"@vitest/coverage-v8": "4.1.10",
		"jss": "^10.10.0",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=20"
	}
}
