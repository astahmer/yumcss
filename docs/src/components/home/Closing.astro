---
import butt from "../../../yums/svg/butt.svg";
import InstallCommand from "./InstallCommand.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="closing" aria-labelledby="closing-title">
	<div class="closing__copy">
		<h2 id="closing-title">Typed styles in five minutes.</h2>
		<p>Add the package, create a <code>css</code> instance from a preset, and add the Vite plugin.</p>
		<div class="closing__actions">
			<a class="home-button home-button--primary" href={`${base}/start/quick-start/`}>Read the quick start</a>
			<a class="home-button" href={`${base}/start/why/`}>Why YumCSS</a>
		</div>
		<InstallCommand />
	</div>
	<img class="closing__butt" src={butt.src} width={butt.width} height={butt.height} alt="" />
</section>

<style>
	.closing {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		margin-top: clamp(1.5rem, 3vw, 2.5rem);
		padding-top: clamp(2.5rem, 6vw, 4rem);
		border-top: 1px solid var(--home-line);
		border-bottom: 1px solid var(--home-line-strong);
	}
	.closing__copy {
		padding-bottom: clamp(2.5rem, 6vw, 4rem);
	}
	h2 {
		margin: 0;
		font-family: var(--yum-font-display);
		font-size: clamp(1.9rem, 4vw, 2.8rem);
		font-weight: 760;
		line-height: 1.05;
		letter-spacing: -0.04em;
		color: var(--home-heading);
	}
	p {
		max-width: 30rem;
		margin: 0.9rem 0 0;
		color: var(--home-muted);
	}
	p code {
		font-family: var(--sl-font-mono);
		font-size: 0.88em;
		color: var(--home-heading);
		background: var(--home-line);
		border: 0;
		padding: 0.08em 0.3em;
		border-radius: 5px;
	}
	.closing__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.closing__butt {
		flex: none;
		width: clamp(3.5rem, 7vw, 5rem);
		height: auto;
		margin-right: clamp(0rem, 4vw, 3rem);
		/* butt.svg has a 9.1% transparent bottom margin. */
		translate: 0 9.1%;
	}
	@media (max-width: 40rem) {
		.closing__butt {
			position: absolute;
			right: 0;
			bottom: -1px;
			width: 3rem;
			margin: 0;
		}
	}
</style>
