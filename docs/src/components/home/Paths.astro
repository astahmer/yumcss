---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const paths = [
	{
		title: "New project",
		text: "Typed CSS objects with css(), extracted to atomic CSS. The recommended path.",
		entry: "css()",
		href: "/start/quick-start/",
	},
	{
		title: "Building a design system",
		text: "Tokens, semantic themes, conditions, and a vocabulary nobody can step outside of.",
		entry: "presets",
		href: "/design-system/presets/",
	},
	{
		title: "Building a component library",
		text: "Variants, component tokens, overrides, and shipping prebuilt CSS.",
		entry: "variants",
		href: "/components/component-library/",
	},
	{
		title: "Coming from Tailwind",
		text: "Typed tw(), css() that emits Tailwind classes, or a gradual move off Tailwind.",
		entry: "tw()",
		href: "/tailwind/overview/",
	},
	{
		title: "Designers & Figma",
		text: "$frame, $layout, $text: an inspector-panel vocabulary, plus design-token import.",
		entry: "$frame",
		href: "/design-system/design-css/",
	},
	{
		title: "Migrating a codebase",
		text: "styled-components, Emotion, Panda, StyleX, Chakra and 25+ more, with previews and residual reports.",
		entry: "yumcss-codemod",
		href: "/migrate/overview/",
	},
];
---

<section class="paths" aria-labelledby="paths-title">
	<div class="paths__intro">
		<h2 id="paths-title">Start from where you are</h2>
		<p>Six ways in, depending on what you already have. Each path starts from the API or tool on its left.</p>
		<a class="paths__fallback" href={`${base}/start/quick-start/`}>Not sure? Start with the quick start →</a>
	</div>
	<ul class="paths__list">
		{
			paths.map((path) => (
				<li>
					<a class="path" href={`${base}${path.href}`}>
						<code class="path__entry">{path.entry}</code>
						<span class="path__title">{path.title}</span>
						<span class="path__text">{path.text}</span>
						<span class="path__arrow" aria-hidden="true">
							→
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.paths {
		display: grid;
		gap: 2rem;
		padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(1.5rem, 3vw, 2.5rem);
	}
	@media (min-width: 60rem) {
		.paths {
			grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
			gap: 4rem;
		}
		.paths__intro {
			position: sticky;
			top: calc(var(--sl-nav-height, 4rem) + 2rem);
			align-self: start;
			padding-left: 1.25rem;
			border-left: 3px solid var(--yum-orange);
		}
	}
	h2 {
		margin: 0;
		font-family: var(--yum-font-display);
		font-size: clamp(2rem, 4vw, 2.9rem);
		font-weight: 760;
		line-height: 1.02;
		letter-spacing: -0.04em;
		color: var(--home-heading);
		text-wrap: balance;
	}
	.paths__intro p {
		margin: 1rem 0 0;
		max-width: 22rem;
		line-height: 1.6;
		color: var(--home-muted);
	}
	.paths__fallback {
		display: inline-block;
		margin-top: 1.25rem;
		font-size: 0.92rem;
		font-weight: 650;
		color: var(--home-accent-text);
		text-decoration: none;
	}
	.paths__fallback:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.paths__list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--home-line);
	}
	.paths__list li {
		margin: 0;
		border-bottom: 1px solid var(--home-line);
	}
	.path {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.3rem 1.5rem;
		padding: 1.05rem 1rem;
		color: inherit;
		text-decoration: none;
		transition: background-color 180ms;
	}
	.path::before {
		content: "";
		position: absolute;
		inset-block: 0.6rem;
		left: 0;
		width: 3px;
		border-radius: 3px;
		background: var(--yum-orange);
		transform: scaleY(0);
		transition: transform 200ms ease-out;
	}
	@media (min-width: 44rem) {
		.path {
			grid-template-columns: 9rem minmax(0, 1fr) auto;
			align-items: baseline;
		}
		.path__entry {
			grid-row: span 2;
		}
		.path__arrow {
			grid-row: 1 / span 2;
			grid-column: 3;
			align-self: center;
		}
	}
	@media (max-width: 43.99rem) {
		.path {
			padding-inline: 0.75rem;
		}
		.path__entry,
		.path__title,
		.path__text {
			grid-column: 1;
		}
		.path__arrow {
			grid-column: 2;
			grid-row: 1 / span 3;
			align-self: center;
		}
	}
	.path__entry {
		justify-self: start;
		padding: 0.15rem 0.45rem;
		border-radius: 6px;
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		color: var(--home-accent-text);
		background: transparent;
		border: 0;
		transition:
			background-color 180ms,
			color 180ms;
	}
	.path__title {
		font-family: var(--yum-font-display);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--home-heading);
		transition: color 180ms;
	}
	.path__text {
		font-size: 0.93rem;
		line-height: 1.55;
		color: var(--home-muted);
	}
	.path__arrow {
		color: var(--home-faint);
		font-size: 1.2rem;
		transition:
			transform 180ms,
			color 180ms;
	}
	.path:is(:hover, :focus-visible) {
		background: var(--home-hover);
	}
	.path:is(:hover, :focus-visible)::before {
		transform: scaleY(1);
	}
	.path:is(:hover, :focus-visible) .path__entry {
		background: var(--yum-orange);
		color: var(--yum-charcoal);
	}
	.path:is(:hover, :focus-visible) .path__title {
		color: var(--home-accent-text);
	}
	.path:is(:hover, :focus-visible) .path__arrow {
		color: var(--home-accent-text);
		transform: translateX(4px);
	}
	.path:focus-visible {
		outline-offset: -2px;
	}
	@media (prefers-reduced-motion: reduce) {
		.path::before,
		.path__arrow {
			transition: none;
		}
		.path:is(:hover, :focus-visible) .path__arrow {
			transform: none;
		}
	}
</style>
