---
import peek from "../../../yums/brand/logo-mark.svg";
import { playgroundHref } from "../../site-links";
import InstallCommand from "./InstallCommand.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Real output of the example preset (apps/playground) for the style below.
const className = "1f29p40 14edf0f d660fb 1qg7yvw 16zvvsi 5ekf4e";
const atomicCss = [
	[".\\31 4edf0f", "border-radius", "0.75rem"],
	["@media (min-width: 768px){.\\35 ekf4e", "border-radius", "1rem}"],
	[".d660fb", "background-color", "#ffffff"],
	[".\\31 qg7yvw", "color", "#111827"],
	[".\\31 f29p40", "display", "flex"],
	[".\\31 6zvvsi:hover", "background-color", "#f9fafb"],
];
---

<section class="hero" data-hero data-state="error">
	<div class="hero__copy">
		<p class="hero__eyebrow">Typed styles · zero-runtime CSS</p>
		<h1 class="hero__title">
			Your design system, <span>as a type system.</span>
		</h1>
		<p class="hero__lead">
			YumCSS checks every style against your tokens while you type, then compiles it to plain class
			strings and one atomic stylesheet at build time.
		</p>
		<p class="hero__sublead">
			Bring your Tailwind, your Figma tokens, or your old CSS-in-JS along. Adopt it alongside existing
			Tailwind, Panda, or StyleX code by choosing compatible class-name output.
		</p>
		<div class="hero__actions">
			<a class="home-button home-button--primary" href={`${base}/start/quick-start/`}>Get started</a>
			<a class="home-button" href={playgroundHref({ path: "/basics", api: "css" })} target="_blank" rel="noopener">
				Open the playground <span aria-hidden="true">↗</span>
			</a>
		</div>
		<InstallCommand />
	</div>

	<div class="hero__demo">
		<div class="hero__perch" aria-hidden="true">
			<img class="hero__peek" src={peek.src} width={peek.width} height={peek.height} alt="" />
		</div>

		<div class="editor">
			<div class="editor__bar">
				<span class="editor__dots" aria-hidden="true"><i></i><i></i><i></i></span>
				<span class="editor__tab">card.tsx</span>
			</div>
			<pre class="editor__code" aria-label="card.tsx"><code><span class="ln"><span class="k">import</span> {"{"} <span class="f">css</span> {"}"} <span class="k">from</span> <span class="s">"./css"</span>;</span>
<span class="ln"></span>
<span class="ln"><span class="k">export const</span> <span class="f">Card</span> = () =&gt; (</span>
<span class="ln">  &lt;<span class="t">article</span></span>
<span class="ln">    <span class="a">className</span>={"{"}<span class="f">css</span>.<span class="f">class</span>({"{"}</span>
<span class="ln">      <span class="p">display</span>: <span class="s">"flex"</span>,</span>
<span class="ln">      <span class="p">borderRadius</span>: <span class="s">"xl"</span>,</span>
<span class="ln ln--focus">      <span class="p">backgroundColor</span>: <span class="swap"><span class="swap__bad">"#2563eb"</span><span class="swap__good">"$white"</span></span>,</span>
<span class="ln">      <span class="p">color</span>: <span class="s tok">"$gray-900"</span>,</span>
<span class="ln">      <span class="p">_hover</span>: {"{"} <span class="p">backgroundColor</span>: <span class="s tok">"$gray-50"</span> {"}"},</span>
<span class="ln">      <span class="p">md</span>: {"{"} <span class="p">borderRadius</span>: <span class="s">"2xl"</span> {"}"},</span>
<span class="ln">    {"}"}){"}"}</span>
<span class="ln">  /&gt;</span>
<span class="ln">);</span></code></pre>

			<div class="editor__hover" role="note">
				<p class="editor__hover-message">
					Type <code>'"#2563eb"'</code> is not assignable to type <code
						>'… PropValue&lt;YumCSSPropertyContract, TokenCatalog&lt;{"{"} colors: {"{"} $white; $black;
						"$gray-50"; … {"}"} {"}"}&gt;, "backgroundColor"&gt; …'</code
					>.
				</p>
				<p class="editor__hover-code">ts(2322)</p>
			</div>

			<div class="editor__panel">
				<div class="editor__panel-bar">
					<span class="editor__status editor__status--bad"><b>●</b> 1 problem</span>
					<span class="editor__status editor__status--good"><b>✓</b> Built · 6 atomic rules</span>
					<button class="editor__toggle" type="button" aria-pressed="false" data-hero-toggle>
						<span class="editor__toggle--bad">Use a token instead</span>
						<span class="editor__toggle--good">Show the type error</span>
					</button>
				</div>
				<div class="editor__output">
					<p class="editor__classname"><span class="a">className</span>=<span class="s">"{className}"</span></p>
					<pre class="editor__css"><code>{atomicCss.map(([selector, property, value]) => <span class="ln"><span class="sel">{selector}</span>{"{"}<span class="p">{property}</span>:{value}{"}"}</span>)}</code></pre>
				</div>
			</div>
		</div>
		<p class="hero__footnote">Real compiler output from the playground's example preset.</p>
	</div>
</section>

<script>
	const hero = document.querySelector<HTMLElement>("[data-hero]");
	const toggle = hero?.querySelector<HTMLButtonElement>("[data-hero-toggle]");
	if (hero && toggle) {
		const setState = (state: "error" | "fixed") => {
			hero.dataset.state = state;
			toggle.setAttribute("aria-pressed", String(state === "fixed"));
		};
		toggle.addEventListener("click", () => setState(hero.dataset.state === "error" ? "fixed" : "error"));

	}
</script>

<style>
	.hero {
		display: grid;
		gap: 3.5rem;
		align-items: center;
		padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
	}
	@media (min-width: 64rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
			gap: 4rem;
		}
	}

	.hero__eyebrow {
		margin: 0 0 1.4rem;
		font-family: var(--sl-font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		color: var(--home-muted);
	}
	.hero__eyebrow::before {
		content: "";
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.6rem;
		border-radius: 2px;
		background: var(--yum-orange);
	}
	.hero__title {
		margin: 0;
		font-family: var(--yum-font-display);
		font-size: clamp(2.75rem, 6.4vw, 5rem);
		font-weight: 760;
		line-height: 0.98;
		letter-spacing: -0.045em;
		color: var(--home-heading);
		text-wrap: balance;
	}
	.hero__title span {
		display: block;
		color: var(--home-accent-display);
	}
	.hero__lead {
		max-width: 33rem;
		margin: 1.6rem 0 0;
		font-size: 1.2rem;
		line-height: 1.55;
		color: var(--home-text);
	}
	.hero__sublead {
		max-width: 33rem;
		margin: 0.9rem 0 0;
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--home-muted);
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.hero__demo {
		/* logo-mark.svg is Peek framed at 276×205; its paws overlap the editor's top edge. */
		--perch-width: clamp(8rem, 16vw, 12.5rem);
		--perch-height: calc(var(--perch-width) * 205 / 276);
		--paw-overlap: 0.7rem;
		position: relative;
		min-width: 0;
		padding-top: calc(var(--perch-height) - var(--paw-overlap));
	}
	.hero__perch {
		position: absolute;
		top: 0;
		right: 8%;
		width: var(--perch-width);
		height: var(--perch-height);
		overflow: hidden;
		z-index: 2;
		pointer-events: none;
	}
	.hero__peek {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: auto;
		animation: peek-up 900ms 250ms cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
	}
	@keyframes peek-up {
		from {
			transform: translateY(100%);
		}
	}

	.editor {
		--code-size: clamp(0.74rem, 1.4vw, 0.86rem);
		--code-line: calc(var(--code-size) * 1.7);
		position: relative;
		border: 1px solid var(--ink-line-strong);
		border-radius: 16px;
		background: var(--ink-surface);
		box-shadow: var(--home-shadow);
	}
	.editor__bar {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 2.6rem;
		padding-inline: 1rem;
		border-bottom: 1px solid var(--ink-line);
	}
	.editor__dots {
		display: flex;
		gap: 6px;
	}
	.editor__dots i {
		width: 10px;
		height: 10px;
		border-radius: 999px;
		background: rgb(254 247 237 / 0.14);
	}
	.editor__tab {
		font-family: var(--sl-font-mono);
		font-size: 0.78rem;
		color: var(--ink-text);
	}
	.editor__code {
		margin: 0;
		padding: 1.1rem 1.25rem 1.2rem;
		overflow-x: auto;
		font-family: var(--sl-font-mono);
		font-size: var(--code-size);
		line-height: var(--code-line);
		color: var(--ink-text);
		background: none;
		border: 0;
		counter-reset: line;
	}
	.editor__code .ln::before {
		counter-increment: line;
		content: counter(line);
		display: inline-block;
		width: 1.6rem;
		margin-right: 1rem;
		text-align: right;
		color: rgb(254 247 237 / 0.22);
		user-select: none;
	}
	.ln--focus {
		display: inline-block;
		width: calc(100% + 2.5rem);
		margin-inline: -1.25rem;
		padding-inline: 1.25rem;
		transition: background-color 300ms;
	}
	[data-state="error"] .ln--focus {
		background: rgb(239 68 68 / 0.08);
	}

	.swap__bad {
		color: var(--code-string);
		text-decoration: underline wavy var(--yum-coral);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 4px;
	}
	.swap__good {
		display: none;
		color: var(--yum-orange);
		font-weight: 600;
	}
	[data-state="fixed"] .swap__bad {
		display: none;
	}
	[data-state="fixed"] .swap__good {
		display: inline;
		animation: settle 420ms ease-out;
	}
	@keyframes settle {
		from {
			background: rgb(245 158 66 / 0.25);
		}
	}

	.editor__hover {
		position: absolute;
		z-index: 3;
		/* Just under line 8: title bar + code padding + 8 code lines. */
		top: calc(2.6rem + 1.1rem + 8 * var(--code-line) + 0.25rem);
		left: clamp(2.5rem, 12vw, 9rem);
		right: 1rem;
		max-width: 28rem;
		padding: 0.75rem 0.9rem;
		border: 1px solid var(--ink-line-strong);
		border-radius: 10px;
		background: #2a2725;
		box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.8);
		transition:
			opacity 220ms,
			transform 220ms;
	}
	[data-state="fixed"] .editor__hover {
		opacity: 0;
		transform: translateY(-4px);
		pointer-events: none;
		visibility: hidden;
	}
	.editor__hover-message {
		margin: 0;
		font-size: 0.8rem;
		line-height: 1.5;
		color: var(--ink-text);
	}
	.editor__hover code {
		font-family: var(--sl-font-mono);
		font-size: 0.74rem;
		color: var(--yum-cream);
		word-break: break-word;
	}
	.editor__hover-code {
		margin: 0.4rem 0 0;
		font-family: var(--sl-font-mono);
		font-size: 0.72rem;
		color: var(--ink-faint);
	}

	.editor__panel {
		border-top: 1px solid var(--ink-line);
		background: var(--ink-sunken);
		border-radius: 0 0 16px 16px;
	}
	.editor__panel-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		padding: 0.6rem 1rem;
		border-bottom: 1px solid var(--ink-line);
		font-size: 0.8rem;
	}
	.editor__status b {
		font-weight: 700;
	}
	.editor__status--bad {
		color: #ff8a80;
	}
	.editor__status--good {
		display: none;
		color: var(--yum-orange);
	}
	[data-state="fixed"] .editor__status--bad,
	[data-state="error"] .editor__status--good {
		display: none;
	}
	[data-state="fixed"] .editor__status--good {
		display: inline;
	}
	.editor__toggle {
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--ink-line-strong);
		border-radius: 8px;
		background: transparent;
		color: var(--yum-cream);
		font: inherit;
		font-size: 0.78rem;
		font-weight: 600;
		cursor: pointer;
	}
	.editor__toggle:hover {
		border-color: var(--yum-orange);
	}
	.editor__toggle--good,
	[data-state="fixed"] .editor__toggle--bad {
		display: none;
	}
	[data-state="fixed"] .editor__toggle--good {
		display: inline;
	}

	.editor__output {
		padding: 0.9rem 1.25rem 1.1rem;
		font-family: var(--sl-font-mono);
		font-size: clamp(0.7rem, 1.25vw, 0.78rem);
		transition: opacity 300ms;
	}
	[data-state="error"] .editor__output {
		opacity: 0.32;
		filter: grayscale(1);
	}
	.editor__classname {
		margin: 0 0 0.6rem;
		overflow-x: auto;
		white-space: nowrap;
		color: var(--ink-text);
	}
	.editor__css {
		margin: 0;
		padding: 0;
		overflow-x: auto;
		background: none;
		border: 0;
		font: inherit;
		line-height: 1.65;
		color: var(--ink-muted);
	}
	.editor__css .ln {
		display: block;
	}
	.hero__footnote {
		margin: 0.75rem 0 0;
		font-size: 0.75rem;
		color: var(--home-faint);
		text-align: right;
	}

	.k {
		color: var(--code-keyword);
	}
	.f {
		color: var(--code-function);
	}
	.s {
		color: var(--code-string);
	}
	.tok {
		color: var(--yum-orange);
	}
	.t {
		color: var(--code-tag);
	}
	.a,
	.p {
		color: var(--code-property);
	}
	.sel {
		color: var(--code-function);
	}

	@media (max-width: 40rem) {
		.editor__hover {
			left: 1rem;
		}
		.hero__footnote {
			text-align: left;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero__peek,
		[data-state="fixed"] .swap__good {
			animation: none;
		}
	}
</style>
