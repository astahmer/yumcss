---
import { Image } from "astro:assets";
import playground from "../assets/screenshots/playground-dss.png";
import inspector from "../assets/screenshots/inspector-tokens.png";
import build from "../assets/screenshots/inspector-build.png";
import migration from "../assets/screenshots/playground-migrate.png";
import compiler from "../assets/screenshots/compiler-preview.png";
import preview from "../assets/screenshots/migration-preview.png";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const tools = [
	{ title: "Playground", text: "Every API, every class-name strategy, live in the browser.", image: playground, href: "/tools/playground/" },
	{ title: "Inspector", text: "Your token catalog, usage, dead tokens, and relationships.", image: inspector, href: "/tools/inspector/" },
	{ title: "Build report", text: "What folded at build time, what ships, and what it costs.", image: build, href: "/tools/inspector/#build-report" },
	{ title: "Migration lab", text: "Real adapters from 30+ styling libraries, with residual reports.", image: migration, href: "/migrate/overview/" },
	{ title: "Migration Preview", text: "Try a migration on your own repo. Read-only, never writes.", image: preview, href: "/tools/migration-preview/" },
	{ title: "Compiler Preview", text: "Each file before and after your real Vite pipeline.", image: compiler, href: "/tools/migration-preview/#compiler-preview" },
];
---

<div class="tools not-content">
	{
		tools.map((tool) => (
			<a class="tool" href={`${base}${tool.href}`}>
				<div class="tool__shot">
					<Image src={tool.image} alt="" widths={[480, 960]} sizes="(min-width: 64rem) 22rem, 100vw" />
				</div>
				<div class="tool__copy">
					<h3>{tool.title}</h3>
					<p>{tool.text}</p>
				</div>
			</a>
		))
	}
</div>

<style>
	.tools {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
		margin-block: 1.5rem;
	}
	.tool {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--yum-radius);
		background: var(--yum-surface);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 160ms,
			transform 160ms;
	}
	.tool:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-2px);
	}
	.tool__shot {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-bottom: 1px solid var(--sl-color-hairline-light);
	}
	.tool__shot img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
	}
	.tool__copy {
		padding: 0.9rem 1rem 1.1rem;
	}
	.tool h3 {
		margin: 0;
		font-family: var(--yum-font-display);
		font-size: 1.05rem;
		color: var(--sl-color-white);
	}
	.tool p {
		margin: 0.3rem 0 0;
		font-size: 0.88rem;
		color: var(--sl-color-gray-3);
	}
</style>
