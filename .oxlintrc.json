{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["./node_modules/emilint/configs/oxlint-generic.json"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"plugins": ["typescript", "unicorn", "import"],
	"rules": {
		"typescript/no-non-null-assertion": "off",
		"typescript/no-extraneous-class": "off",
		"eslint/no-await-in-loop": "off",
		"eslint/no-shadow": "off",
		"unicorn/no-array-for-each": "off",
		"unicorn/consistent-function-scoping": "off",
		"unicorn/prefer-add-event-listener": "off",
		"eslint/no-underscore-dangle": "off",
		"import/no-unassigned-import": "off",
		"pandwind-extraction/no-spreads": "warn",
		"pandwind-extraction/no-dynamic-values": "warn",
		"pandwind-extraction/no-multiple-conditionals": "warn",
		"pandwind-extraction/no-redundant-cx": "error",
		"pandwind-extraction/no-dollar-raw": "error",
		"pandwind-extraction/prefer-typed-css-values": "error",
		"pandwind-extraction/no-arbitrary-values": "error",
		"pandwind-extraction/migration-skip-reason": "error",
		"pandwind-extraction/no-stale-migration-skip": "error",
		"pandwind-extraction/require-migration-residual": "error",
		"pandwind-extraction/no-conflicting-style-props": "error",
		"pandwind-extraction/no-dynamic-carrier-fallback": "error",
		"pandwind-extraction/no-dynamic-keyframes": "error",
		"pandwind-extraction/no-raw-ast-identities": "error",
		// Enable shared checks as their existing repository findings are resolved.
		"antislop/no-unknown-type-aliases": "error",
		"antislop/no-widen-then-assert": "error",
		"antislop/no-chained-type-assertions": "error",
		"antislop/no-broad-object-parameters": "error",
		"antislop/no-conditional-empty-object-spread": "off",
		"antislop/no-known-value-widening": "off",
		"antislop/no-reflect-apply": "error",
		"antislop/no-reflect-get": "error",
		"antislop/no-runtime-typeof": "off",
		"antislop/no-unsafe-dictionary-type": "off",
		"antislop/no-unknown-parameters": "off",
		"antislop/no-unknown-returns": "off",
		"antislop/require-safety-comment-for-type-assertion": "off",
		// These Oxc perf rules were absent from the pre-Emilint plugin set.
		"oxc/no-map-spread": "off",
		"oxc/no-accumulating-spread": "off"
	},
	"ignorePatterns": [
		"**/examples/example/src/types.d.ts",
		"**/examples/example/src/pandwind.safelist.ts",
		"**/examples/example/src/tw.ts",
		"**/dist/**",
		"**/docs/.astro/**",
		"**/docs/node_modules/**",
		"**/apps/playground/src/generated/**",
		"**/apps/playground/e2e/.migration-preview-features-gen/**",
		"scripts/**/*.d.ts",
		"**/packages/codemod/tests/routes/**",
		"**/packages/codemod/tests/roundtrips/**",
		"**/packages/analyze/tests/fixtures/**"
	],
	"jsPlugins": [
		"./packages/lint-plugin/dist/index.js",
		{
			"name": "antislop",
			"specifier": "emilint/oxlint"
		}
	],
	"overrides": [
		{
			"files": [
				"**/tests/**",
				"**/*.test.*",
				"**/*.tst.*",
				"**/fixtures/**",
				"**/dist/**",
				"**/*.mts"
			],
			"rules": {
				"pandwind-extraction/no-spreads": "off",
				"pandwind-extraction/no-dynamic-values": "off",
				"pandwind-extraction/no-multiple-conditionals": "off",
				"pandwind-extraction/no-redundant-cx": "off",
				"pandwind-extraction/no-dollar-raw": "off",
				"pandwind-extraction/prefer-typed-css-values": "off",
				"pandwind-extraction/no-arbitrary-values": "off",
				"pandwind-extraction/migration-skip-reason": "off",
				"pandwind-extraction/no-stale-migration-skip": "off",
				"pandwind-extraction/require-migration-residual": "off",
				"pandwind-extraction/no-conflicting-style-props": "off",
				"pandwind-extraction/no-dynamic-carrier-fallback": "off",
				"pandwind-extraction/no-dynamic-keyframes": "off",
				"pandwind-extraction/no-raw-ast-identities": "off"
			}
		}
	]
}
