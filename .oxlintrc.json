{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"plugins": ["typescript", "unicorn", "import"],
	"rules": {
		"typescript/no-non-null-assertion": "off",
		"unicorn/no-array-for-each": "off",
		"eslint/no-underscore-dangle": "off",
		"import/no-unassigned-import": "off",
		"pandwind-extraction/no-spreads": "warn",
		"pandwind-extraction/no-dynamic-values": "warn",
		"pandwind-extraction/no-multiple-conditionals": "warn",
		"pandwind-extraction/no-dollar-raw": "error",
		"pandwind-extraction/no-arbitrary-values": "error",
		"pandwind-extraction/design-tokens-only": "error"
	},
	"ignorePatterns": [
		"**/apps/example/src/types.d.ts",
		"**/apps/example/src/pandwind.safelist.ts",
		"**/apps/example/src/tw.ts",
		"**/dist/**",
		"**/docs/.astro/**",
		"**/docs/node_modules/**",
		"**/packages/analyze/tests/fixtures/**",
		"**/examples/stylex-docs-migration/source/**"
	],
	"jsPlugins": ["./packages/lint-plugin/src/index.js"],
	"overrides": [
		{
			"files": [
				"**/tests/**",
				"**/*.test.*",
				"**/*.tst.*",
				"**/fixtures/**",
				"**/dist/**",
				"**/*.mts"
			],
			"rules": {
				"pandwind-extraction/no-spreads": "off",
				"pandwind-extraction/no-dynamic-values": "off",
				"pandwind-extraction/no-multiple-conditionals": "off",
				"pandwind-extraction/no-dollar-raw": "off",
				"pandwind-extraction/no-arbitrary-values": "off",
				"pandwind-extraction/design-tokens-only": "off"
			}
		},
		{
			"files": ["**/scripts/**", "**/packages/codemod/tests/**"],
			"rules": {
				"eslint/no-await-in-loop": "off",
				"typescript/no-extraneous-class": "off",
				"unicorn/consistent-function-scoping": "off"
			}
		},
		{
			"files": ["**/packages/codemod/src/swap/identifiers.ts"],
			"rules": {
				"typescript/no-extraneous-class": "off"
			}
		}
	]
}
