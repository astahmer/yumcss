{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["./node_modules/emilint/configs/oxlint-generic.json"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"plugins": ["typescript", "unicorn", "import"],
	"rules": {
		"typescript/no-non-null-assertion": "off",
		"typescript/no-extraneous-class": "off",
		"eslint/no-await-in-loop": "off",
		"eslint/no-shadow": "off",
		"unicorn/no-array-for-each": "off",
		"unicorn/consistent-function-scoping": "off",
		"unicorn/prefer-add-event-listener": "off",
		"eslint/no-underscore-dangle": "off",
		"import/no-unassigned-import": "off",
		"yumcss-extraction/no-spreads": "warn",
		"yumcss-extraction/no-dynamic-values": "warn",
		"yumcss-extraction/no-multiple-conditionals": "warn",
		"yumcss-extraction/no-redundant-cx": "error",
		"yumcss-extraction/no-dollar-raw": "error",
		"yumcss-extraction/prefer-typed-css-values": "error",
		"yumcss-extraction/no-arbitrary-values": "error",
		"yumcss-extraction/migration-skip-reason": "error",
		"yumcss-extraction/no-stale-migration-skip": "error",
		"yumcss-extraction/require-migration-residual": "error",
		"yumcss-extraction/no-conflicting-style-props": "error",
		"yumcss-extraction/no-dynamic-carrier-fallback": "error",
		"yumcss-extraction/no-dynamic-keyframes": "error",
		"yumcss-extraction/no-raw-ast-identities": "error",
		// emilint owns the generic defaults; keep only repository-specific tuning here.
		"antislop/no-conditional-empty-object-spread": "off",
		"antislop/no-known-value-widening": "off",
		"antislop/no-runtime-typeof": [
			"error",
			{
				"allowInBoundaryFunctions": true,
				"allowInTypeGuards": true,
				"allowWhenStaticallyTyped": true
			}
		],
		// Dynamic token/config/AST trees stay unknown until their owning parser validates each value.
		"antislop/no-unsafe-dictionary-type": "off",
		// The generic rule cannot express required MCP and bundler-hook boundary inputs.
		"antislop/no-unknown-parameters": "off",
		// Static evaluators and host adapters intentionally return open-ended values for caller-side narrowing.
		"antislop/no-unknown-returns": "off",
		// State non-obvious assertion invariants; comments on every assertion add noise.
		"antislop/require-safety-comment-for-type-assertion": "off",
		// Adapter maps preserve input immutability; Oxc's suggested fix mutates spread values.
		"oxc/no-map-spread": "off",
		// Stage contexts keep immutable completed-stage snapshots; the built-in pipeline has seven stages.
		"oxc/no-accumulating-spread": "off"
	},
	"ignorePatterns": [
		"**/examples/example/src/types.d.ts",
		"**/examples/example/src/yumcss.safelist.ts",
		"**/examples/example/src/tw.ts",
		"**/dist/**",
		"**/docs/.astro/**",
		"**/docs/node_modules/**",
		"**/apps/playground/src/generated/**",
		"**/apps/playground/e2e/.migration-preview-features-gen/**",
		"scripts/**/*.d.ts",
		"**/packages/codemod/tests/routes/**",
		"**/packages/codemod/tests/roundtrips/**",
		"**/packages/analyze/tests/fixtures/**"
	],
	"jsPlugins": [
		"./packages/lint-plugin/dist/index.js",
		{
			"name": "antislop",
			"specifier": "emilint/oxlint"
		}
	],
	"overrides": [
		{
			"files": [
				"**/tests/**",
				"**/*.test.*",
				"**/*.tst.*",
				"**/fixtures/**",
				"**/dist/**",
				"**/*.mts"
			],
			"rules": {
				"yumcss-extraction/no-spreads": "off",
				"yumcss-extraction/no-dynamic-values": "off",
				"yumcss-extraction/no-multiple-conditionals": "off",
				"yumcss-extraction/no-redundant-cx": "off",
				"yumcss-extraction/no-dollar-raw": "off",
				"yumcss-extraction/prefer-typed-css-values": "off",
				"yumcss-extraction/no-arbitrary-values": "off",
				"yumcss-extraction/migration-skip-reason": "off",
				"yumcss-extraction/no-stale-migration-skip": "off",
				"yumcss-extraction/require-migration-residual": "off",
				"yumcss-extraction/no-conflicting-style-props": "off",
				"yumcss-extraction/no-dynamic-carrier-fallback": "off",
				"yumcss-extraction/no-dynamic-keyframes": "off",
				"yumcss-extraction/no-raw-ast-identities": "off"
			}
		}
	]
}
