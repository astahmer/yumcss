{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"plugins": ["typescript", "unicorn", "import"],
	"rules": {
		"typescript/no-non-null-assertion": "off",
		"unicorn/no-array-for-each": "off",
		"eslint/no-underscore-dangle": "off",
		"import/no-unassigned-import": "off",
		"pandwind-extraction/no-spreads": "warn",
		"pandwind-extraction/no-dynamic-values": "warn",
		"pandwind-extraction/no-multiple-conditionals": "warn"
	},
	"ignorePatterns": [
		"**/apps/example/src/types.d.ts",
		"**/apps/example/src/pandwind.safelist.ts",
		"**/apps/example/src/tw.ts",
		"**/dist/**",
		"**/packages/analyze/tests/fixtures/**"
	],
	"jsPlugins": ["./lint/pandwind-extraction.plugin.js"],
	"overrides": [
		{
			"files": [
				"**/tests/**",
				"**/*.test.*",
				"**/*.tst.*",
				"**/fixtures/**",
				"**/dist/**",
				"**/*.mts"
			],
			"rules": {
				"pandwind-extraction/no-spreads": "off",
				"pandwind-extraction/no-dynamic-values": "off",
				"pandwind-extraction/no-multiple-conditionals": "off"
			}
		}
	]
}
